generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN @map("admin")
  STAFF @map("staff")
}

enum PurchaseStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
}

enum SaleStatus {
  PAID    @map("paid")
  PARTIAL @map("partial")
  UNPAID  @map("unpaid")
}

enum InventoryTransactionType {
  IN  @map("in")
  OUT @map("out")
}

enum InventoryReferenceType {
  PURCHASE @map("purchase")
  SALE     @map("sale")
  MANUAL   @map("manual")
}

enum PaymentType {
  SALE     @map("sale")
  PURCHASE @map("purchase")
}

enum PaymentMethod {
  CASH @map("cash")
  UPI  @map("upi")
  CARD @map("card")
}

model Business {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  address   String?   @db.Text
  logo      String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users                 User[]
  categories            Category[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  purchases             Purchase[]
  sales                 Sale[]
  inventoryTransactions InventoryTransaction[]
  payments              Payment[]
  settings              Setting[]

  @@map("businesses")
}

model User {
  id         Int       @id @default(autoincrement())
  businessId Int       @map("business_id")
  name       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       UserRole  @default(STAFF)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([businessId])
  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  businessId  Int       @map("business_id")
  name        String    @db.VarChar(255)
  parentId    Int?      @map("parent_id")
  description String?   @db.Text
  status      Int       @default(1) @db.TinyInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([businessId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id             Int       @id @default(autoincrement())
  businessId     Int       @map("business_id")
  categoryId     Int?      @map("category_id")
  name           String    @db.VarChar(255)
  sku            String?   @unique @db.VarChar(100)
  barcode        String?   @db.VarChar(100)
  price          Decimal   @db.Decimal(10, 2)
  costPrice      Decimal?  @map("cost_price") @db.Decimal(10, 2)
  quantity       Int       @default(0)
  lowStockAlert  Int       @default(0) @map("low_stock_alert")
  unit           String?   @db.VarChar(50)
  status         Int       @default(1) @db.TinyInt
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id         Int       @id @default(autoincrement())
  businessId Int       @map("business_id")
  name       String    @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  email      String?   @db.VarChar(255)
  address    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchases Purchase[]

  @@index([businessId])
  @@map("suppliers")
}

model Customer {
  id         Int       @id @default(autoincrement())
  businessId Int       @map("business_id")
  name       String?   @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  email      String?   @db.VarChar(255)
  address    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sales    Sale[]

  @@index([businessId])
  @@map("customers")
}

model Purchase {
  id            Int            @id @default(autoincrement())
  businessId    Int            @map("business_id")
  supplierId    Int?           @map("supplier_id")
  invoiceNumber String?        @map("invoice_number") @db.VarChar(100)
  totalAmount   Decimal?       @map("total_amount") @db.Decimal(12, 2)
  status        PurchaseStatus @default(COMPLETED)
  purchaseDate  DateTime?      @map("purchase_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items    PurchaseItem[]

  @@index([businessId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         Int       @id @default(autoincrement())
  purchaseId Int       @map("purchase_id")
  productId  Int       @map("product_id")
  quantity   Int
  price      Decimal?  @db.Decimal(10, 2)
  total      Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id            Int         @id @default(autoincrement())
  businessId    Int         @map("business_id")
  customerId    Int?        @map("customer_id")
  invoiceNumber String?     @map("invoice_number") @db.VarChar(100)
  totalAmount   Decimal?    @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal?    @map("paid_amount") @db.Decimal(12, 2)
  dueAmount     Decimal?    @map("due_amount") @db.Decimal(12, 2)
  status        SaleStatus  @default(UNPAID)
  saleDate      DateTime?   @map("sale_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items    SaleItem[]

  @@index([businessId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id         Int       @id @default(autoincrement())
  saleId      Int      @map("sale_id")
  productId   Int      @map("product_id")
  quantity    Int
  price       Decimal? @db.Decimal(10, 2)
  total       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model InventoryTransaction {
  id            Int                      @id @default(autoincrement())
  businessId    Int                      @map("business_id")
  productId     Int                      @map("product_id")
  type          InventoryTransactionType
  referenceType InventoryReferenceType   @map("reference_type")
  referenceId   Int?                     @map("reference_id")
  quantity      Int
  createdAt     DateTime                 @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model Payment {
  id          Int           @id @default(autoincrement())
  businessId  Int           @map("business_id")
  type        PaymentType
  referenceId Int?          @map("reference_id")
  amount      Decimal?      @db.Decimal(12, 2)
  method      PaymentMethod?
  paymentDate DateTime?     @map("payment_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([businessId])
  @@map("payments")
}

model Setting {
  id         Int       @id @default(autoincrement())
  businessId Int       @map("business_id")
  key        String?   @db.VarChar(255)
  value      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([businessId])
  @@map("settings")
}
